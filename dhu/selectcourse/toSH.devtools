<script type="text/javascript">
	var contextPath = '/dhu';
	var studNo = '250410101';
	var scSemester = '20262027a';
	var grade = '2025a';
	var enrollYear = '2025a';
	var lastScoreSemester = '20252026s';
	var extendSemeCnt = 0;
	// 初始化学期数
	if (!$.stringIsEmpty(lastScoreSemester)) {
		var yearTermCnt = (parseInt(lastScoreSemester.substring(0,4))-parseInt(enrollYear.substring(0,4))+1)*2;
		if (8 < yearTermCnt) {
			extendSemeCnt = yearTermCnt - 8;
			$('#yeartermCnt').attr('colspan', yearTermCnt);
			var yeartermPartHtml = '';
			for (var i=0; i<yearTermCnt; i++) {
				if (i%2 == 0) {
					yeartermPartHtml += '<th style="width:'+parseFloat(40)/yearTermCnt+'%;">'+parseInt(i/2+1)+'A</th>';
				} else {
					yeartermPartHtml += '<th style="width:'+parseFloat(40)/yearTermCnt+'%;">'+parseInt(i/2+1)+'B</th>';
				}
			}
			$('#yeartermPart').html(yeartermPartHtml);
		}
	}
</script>
</html>